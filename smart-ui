function promptFor(section){let wanted={production:['coal_output','coal_import'],demand:['coal_consumption','coal_daily_use','thermal_generation','steel','cement'],transport:['coal_rail','coal_stock','stock_days','port_trans'],price:['thermal_price','contract_price'],outlook:[],forecast:[]}[section]||[];let selected=(wanted.length?S.records.filter(r=>wanted.includes(r.metricId)):S.records).sort((a,b)=>a.period.localeCompare(b.period)).slice(-90);

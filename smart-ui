function plotSelected(){let list=series();let el=$('v4Plot'), tbl=$('v4SeriesTable');if(!list.length){el.innerHTML='<span class="smart-mini">当前筛选条件没有记录。可以切换月度/累计/年度，或导入其他文件。</span>';tbl.innerHTML='';$('v4GapSummary').textContent='当前筛选条件无数据。';return;}let arr=list.slice(-90),min=Math.min(...arr.map(r=>r.value)),max=Math.max(...arr.map(r=>r.value)),pad=(max-min)||Math.max(Math.abs(min)*.2,1);let low=min-pad*.18,high=max+pad*.18,W=800,H=285,left=66,top=25,pw=660,ph=185;

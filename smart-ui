function renderScopes(){let token=$('v4Metric').value, mid=token?.split('|')[0];let scopes=[...new Set(S.records.filter(r=>r.metricId===mid).map(r=>r.scope))].sort();let active=$('v4Scope').value;$('v4Scope').innerHTML=scopes.map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join('');if(scopes.includes(active))$('v4Scope').value=active;}

async function onFiles(files){if(!files?.length)return;if(!window.XLSX)return notify('Excel解析组件未加载：请检查网络或CDN访问','error');notify('正在读取工作表，分析时间、单位和指标…');try{let books=await extractFiles(files),parsed=C.detectSheets(books);S.parsed=parsed;S.merge=null;S.selected=[];let countSheets=books.reduce((n,b)=>n+b.sheets.length,0);$('v4ImportSummary').innerHTML=`<span>${books.length}个文件</span><span>${countSheets}张工作表</span><span>${parsed.groups.length}组候选指标</span><span>${parsed.total.toLocaleString('zh-CN')}条候选记录</span>`;renderGroups();$('v4MergeSummary').innerHTML='<span>尚未比对数据库</span>';notify(parsed.groups.length?`已识别${parsed.groups.length}组指标。请逐项核对建议映射，尤其检查单位及月度/累计口径；未识别工作表：${parsed.issues.length}项。`:'没有找到可以安全识别的日期+指标列，请在V3.0工作表自助出图中手动映射。',parsed.groups.length?'ok':'warn');}catch(e){notify('导入失败：'+e.message,'error')}}

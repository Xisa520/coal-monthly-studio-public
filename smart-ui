 for(let i=0;i<=4;i++){let y=top+i*ph/4;svg+=`<line x1="${left}" y1="${y}" x2="${left+pw}" y2="${y}" stroke="#e0eaf0"/><text x="${left-10}" y="${y+4}" text-anchor="end" fill="#7890a1" font-size="12">${esc(fmt(high-(high-low)*i/4))}</text>`;}svg+=`<path d="${line}" fill="none" stroke="#177a97" stroke-width="3" stroke-linejoin="round"/>`;
 pts.forEach((p,i)=>{if(i%Math.max(1,Math.ceil(pts.length/11))===0||i===pts.length-1)svg+=`<text x="${p.x}" y="${top+ph+28}" text-anchor="middle" fill="#6c8091" font-size="12">${esc(p.p)}</text>`;if(pts.length<=48)svg+=`<circle cx="${p.x}" cy="${p.y}" r="3.1" fill="#1a7da0"><title>${esc(p.p)} ${esc(fmt(p.v))}</title></circle>`});el.innerHTML=svg+'</svg>';
 tbl.innerHTML=`<table><thead><tr><th>期间</th><th>值</th><th>单位</th><th>核验</th><th>来源</th></tr></thead><tbody>${list.slice(-100).map(r=>`<tr><td>${esc(r.period)}</td><td>${fmt(r.value)}</td><td>${esc(r.unit)}</td><td><span class="smart-pill ${String(r.status).startsWith('reviewed')?'ok':'pending'}">${String(r.status).startsWith('reviewed')?'已审核':'待审核'}</span></td><td>${esc(r.sourceFile)} / ${esc(r.sourceSheet||'')}</td></tr>`).join('')}</tbody></table>`;
 const freq=$('v4Freq').value,gaps=['cumulative','day'].includes(freq)?[]:C.gaps(S.records,{metricId:list[0].metricId,scope:list[0].scope,frequency:freq});$('v4GapSummary').textContent=freq==='cumulative'?`当前为累计口径：共有${list.length}期，系统不将累计间隔解释为缺失月度。`:freq==='day'?`当前为日度序列：已有${list.length}条；未对周末、节假日及停报日自动判定缺失。`:`已记录${list.length}期 · 缺失${gaps.length}期${gaps.length?'：'+gaps.slice(0,18).join('、')+(gaps.length>18?'等':''):''}。缺失数据不填0、不推算。`;}
async function approve(){let list=series().filter(r=>!String(r.status).startsWith('reviewed'));if(!list.length)return alert('当前筛选条件没有待核验记录');if(!confirm(`你是否已对当前筛选指标的 ${list.length} 条待审核记录逐条核对原始来源和口径？确认后才会标记为“用户审核”。`))return;await dbPut(list.map(r=>({...r,status:'reviewed_user',reviewedAt:new Date().toISOString()})));await refresh();}
function officialSource(url){try{const u=new URL(url);return u.protocol==='https:'&&['stats.gov.cn','www.stats.gov.cn'].includes(u.hostname)}catch{return false}}
async function adoptOfficial(){let label=$('v4ManualMetric').value,met=C.METRICS.find(m=>m.id===label),tp=C.parseTime($('v4ManualPeriod').value),freq=$('v4ManualFrequency').value,value=C.num($('v4ManualValue').value),unit=$('v4ManualUnit').value.trim(),scope=$('v4ManualScope').value.trim(),url=$('v4ManualUrl').value.trim();if(!met||!tp||value===null||!unit||!scope||!officialSource(url))return alert('请填写有效的指标、日期、数值、单位、范围和stats.gov.cn官方HTTPS原文网址。');if(tp.frequency!==freq)return alert('统计期间与频率不一致，例如累计应写“2026年1—9月”。');if(!confirm('请确认你已打开国家统计局官方原文，核对统计时间、指标口径、单位和数值。系统不会代你完成事实核验。'))return;
 let rec={metricId:met.id,metric:met.name,period:tp.period,periodLabel:tp.label,frequency:freq,value,unit,scope,status:'reviewed_user',sourceType:'official_verified_by_user',sourceUrl:url,sourceFile:'国家统计局官网（用户核实）',sourceSheet:'手动补录',cell:'',reviewedAt:new Date().toISOString()};let m=C.planMerge(S.records,[rec]);if(m.conflicts.length&&!confirm(`同口径记录原值为${m.conflicts[0].old.value}，新值为${value}。是否确认新值为官方最新修订值并覆盖？`))return;await dbPut([rec]);await refresh();S.sourceLog.unshift(`${new Date().toLocaleString('zh-CN')} ${rec.metric} ${rec.periodLabel} ${rec.value} ${rec.unit}\n${url}`);$('v4SourceLog').textContent=S.sourceLog.slice(0,12).join('\n\n');notify('经用户确认的官方值已采纳，来源链接已保留。','ok');}
async function officialLoad(){try{let r;try{r=await fetch('https://raw.githubusercontent.com/Xisa520/coal-monthly-studio-public/main/data/nbs-public.json?x='+Date.now(),{cache:'no-store'});if(!r.ok)throw Error(r.status)}catch{r=await fetch('./data/nbs-public.json?x='+Date.now(),{cache:'no-store'})}if(!r.ok)throw Error(r.status);let j=await r.json();let articles=j.articles||[];S.officialCandidates=articles.flatMap(a=>(a.candidates||[]).map(c=>({...c,url:a.url,report_month:a.month}))).filter(c=>officialSource(c.url));

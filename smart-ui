 let sections={};
 function summarize(ids){let rs=checked.filter(r=>ids.includes(r.metricId));let keys=[...new Map(rs.map(r=>[r.metric+'|'+r.scope+'|'+r.frequency+'|'+r.unit,1])).keys()];if(!keys.length)return '该专题当前缺少已核验的数据，需要补充对应月份、统计范围和原始来源。';let sentences=[];for(let k of keys.slice(0,7)){let arr=rs.filter(r=>r.metric+'|'+r.scope+'|'+r.frequency+'|'+r.unit===k).sort((a,b)=>a.period.localeCompare(b.period));let latest=arr.at(-1);sentences.push(`据${latest.sourceFile||'已核实数据源'}，${latest.periodLabel||latest.period}${latest.scope}的${latest.metric}为${fmt(latest.value)}${latest.unit}（${latest.frequency==='cumulative'?'累计口径':latest.frequency==='year'?'年度口径':'月度口径'}）。`);}return sentences.join('')+'上述指标应结合可比口径及最新政策、季节性因素进一步研判；未提供资料的因果解释暂不作确定性判断。';}
 for(let [id,ids] of Object.entries(groups))sections[id]=summarize(ids);
 sections.outlook='综合已核实的数据，煤炭市场后续走势需要分别观察生产恢复、进口变化、终端日耗、各环节库存和港口煤价。当前系统仅能罗列已核实事实，尚不具备足够的政策、气象、采购以及模型输出证据，不对未来供需松紧及价格方向作确定性结论。';
 sections.forecast='未导入经过验证的预测模型结果。请在正式报告中补充点预测、预测区间、模型测试集与风险情景，不得使用AI虚构预测结果。';
 for(let [id,txt] of Object.entries(sections)){let el=$('editor_'+id);if(el){el.value=txt;el.dispatchEvent(new Event('input'));}}
 const sum=checked.filter(r=>['coal_output','coal_import','thermal_price','coal_stock'].includes(r.metricId)).sort((a,b)=>a.period.localeCompare(b.period)).slice(-4);$('reportAbstract').value=sum.length?'本期煤炭市场指标摘要（待完善）：'+sum.map(r=>`${r.period} ${r.metric} ${fmt(r.value)}${r.unit}`).join('；')+'。供需及价格研判须综合正式统计、气象和行业监测后完成。':'本月煤炭市场已形成初步数据分析底稿，供需及价格判断待进一步论证。';$('reportTitle').value=$('month').value+' 煤炭市场分析报告（规则初稿）';document.querySelector('.nav[data-view="report"]')?.click();alert('六章节规则初稿已写入月报编辑器。请核实修改后保存草稿或导出Word。');
}

function draftPrompt(){const txt=promptFor($('v4Section').value);S.lastPrompt=txt;$('v4AiOutput').value=txt;notify('数据驱动提示词已经生成。数据仍在本机，尚未调用外部AI。','ok');return txt;}
async function callAi(){const url=$('v4ApiUrl').value.trim().replace(/\/$/,'');const token=$('v4ApiToken').value.trim();if(!(/^(https:\/\/|http:\/\/(?:localhost|127\.0\.0\.1)(?::\d+)?)/.test(url))||!token)return alert('请填写以 https:// 开头的安全AI后端地址和访问口令。仅在自用本地调试时可使用 http://127.0.0.1。');let section=$('v4Section').value, prompt=promptFor(section);if(prompt.length>32000)return alert('分析数据过多，请缩小指标范围。');if(!confirm('这一步会将上述提示词中的数据发送到你填写的AI后端，后端可能再转发模型服务商。请确保数据具备外发许可。确认发送吗？'))return;
 const btn=$('v4AiDraft');btn.disabled=true;btn.textContent='正在分析…';try{const req=await fetch(url+'/api/analyze',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({prompt,section,report_month:$('month').value})});let payload=await req.json().catch(()=>({}));if(!req.ok)throw Error(payload.error||`HTTP ${req.status}`);if(!payload.text)throw Error('AI没有返回正文');S.aiText=payload.text;$('v4AiOutput').value=payload.text;notify('AI草稿已返回，仍需你审阅核验后才能写入正式月报。','ok');}catch(e){notify('AI调用失败：'+e.message,'error')}finally{btn.disabled=false;btn.textContent='调用AI生成草稿'}}
function applyDraft(){let id=$('v4Section').value,el=$('editor_'+id);if(!el)return alert('未找到对应月报编辑器');let txt=$('v4AiOutput').value.trim();if(!txt||txt===S.lastPrompt)return alert('当前只有提示词，没有已经编辑或生成的正文草稿。');if(!confirm('是否将当前文字写入月报正文编辑器？原编辑器已有内容会被覆盖，请先自行保存。'))return;el.value=txt;el.dispatchEvent(new Event('input'));document.querySelector('.nav[data-view="report"]')?.click();alert('已写入月报编辑器，请继续核实后导出Word。');}
function backup(){download(new Blob([JSON.stringify({version:4,exported:new Date().toISOString(),records:S.records},null,2)],{type:'application/json'}),'煤炭市场数据_本机备份_'+new Date().toISOString().slice(0,10)+'.json')}
function csvExport(){const keys=['metric','metricId','scope','period','periodLabel','frequency','value','unit','status','sourceType','sourceFile','sourceSheet','cell','sourceUrl'];const data='\ufeff'+[keys.join(','),...S.records.map(r=>keys.map(k=>csvCell(r[k])).join(','))].join('\r\n');download(new Blob([data],{type:'text/csv;charset=utf-8'}),'煤炭市场标准化数据.csv')}
async function restore(file){if(!file)return;if(file.size>15*1024*1024)return alert('备份文件超过15MB');try{let payload=JSON.parse(await file.text());if(payload.version!==4||!Array.isArray(payload.records))throw Error('不是V4.0格式的JSON备份');if(!confirm(`将备份中的${payload.records.length}条记录合并到本机数据库？同键记录会以备份值覆盖。`))return;let valid=payload.records.filter(r=>C.num(r.value)!==null&&/^20\d{2}(-\d{2})?(-\d{2})?$/.test(r.period)&&r.metricId&&r.frequency&&r.scope&&r.unit).slice(0,100000);await dbPut(valid);await refresh();notify(`已恢复${valid.length}条格式有效记录，其他记录未导入。`,'ok');}catch(e){notify('恢复失败：'+e.message,'error')}}

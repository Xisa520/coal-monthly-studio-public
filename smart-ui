function ruleDraft(){
 const checked=S.records.filter(r=>String(r.status).startsWith('reviewed'));
 if(!checked.length)return alert('当前没有人工审核通过的历史记录。请先逐项核验，不能用待核验数值自动形成定稿。');
 if(!confirm('将用本机已审核数据生成六章节结构化初稿，覆盖原月报编辑器当前文字，但不自动保存。请先保存已有草稿。确定继续？'))return;
